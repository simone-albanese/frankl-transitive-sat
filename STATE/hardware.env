# STATE/hardware.env — budget di risorse misurati sulla macchina reale.
# Rigenerato al bootstrap frankl-transitive: 2026-08-12. Formato sourceable.
# Uso:  source STATE/hardware.env   poi  "$PY" script.py ...

# ---- macchina rilevata (invariata dal progetto precedente) ----
CHIP="Apple M4"
MACOS=15.6.1
NCPU_LOGICI=10
PCORE=4
ECORE=6
RAM_GB=16
DISK_FREE_GB=330

# ---- budget derivati (regola 6 di CLAUDE.md) ----
RAM_JOB_MAX_GB=9              # 60% di 16 GB, arrotondato per difetto
CORES_JOB=3                   # P-core - 1
DISK_MIN_FREE_GB=10
TIMEOUT_DEFAULT_MIN=20        # escalation x3 UNA sola volta, e solo se il
                              # run interrotto mostrava progresso misurabile
TIMEOUT_ESCALATION_MIN=60

# ---- interprete Python del progetto (NON usare "python3" nudo) ----
PY=/Users/simonealbanese/Documents/Matematics/frankl-transitive/.venv/bin/python3
